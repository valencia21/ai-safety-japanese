{
  "name": "ai-safety-japanese",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/foundation dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --cwd apps/foundation start",
    "deploy": "bun run --cwd apps/foundation deploy",
    "test": "bun run --filter '*' test",
    "format": "eslint --fix . && prettier --write .",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.2",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
